{
  "repo": "flowork-os/triger",
  "triggers": [
    {
      "author": "Flowork Sovereign Core",
      "category": "finance",
      "category_id": "CAT-006",
      "command": "node external_triger/btc_whale_alert/watcher.mjs",
      "entry": "watcher.mjs",
      "env_vars": {
        "BTC_ALERT_PRICE": "100000",
        "FLOWORK_CORE_URL": "http://127.0.0.1:9099"
      },
      "exclude_keywords": [
        "forex",
        "stock_nyse"
      ],
      "id": "btc_whale_alert",
      "interval_seconds": 30,
      "keywords": [
        "bitcoin",
        "btc",
        "crypto",
        "whale",
        "breakout"
      ],
      "name": "Bitcoin Whale & Price Breakout Watcher",
      "shard": "index/bt/c_/btc_whale_alert.json",
      "source_path": "triger/bt/btc_whale_alert",
      "target": {
        "agent_id": "crypto-analyst",
        "category_id": "CAT-006",
        "chat_id": "session-crypto-trading",
        "group_id": "group-risk-council"
      },
      "type": "active",
      "version": "1.0.0"
    },
    {
      "author": "Flowork Sovereign Core",
      "category": "automation_admin",
      "category_id": "CAT-014",
      "command": "node external_triger/iot_weather_ambience/watcher.mjs",
      "entry": "watcher.mjs",
      "env_vars": {
        "DARK_LUX_THRESHOLD": "50",
        "FLOWORK_CORE_URL": "http://127.0.0.1:9099"
      },
      "exclude_keywords": [
        "crypto",
        "trading"
      ],
      "id": "iot_weather_ambience",
      "interval_seconds": 60,
      "keywords": [
        "iot",
        "weather",
        "light",
        "sensor",
        "ambience"
      ],
      "name": "IoT Weather & Room Illuminance Ambience Watcher",
      "shard": "index/io/t_/iot_weather_ambience.json",
      "source_path": "triger/io/iot_weather_ambience",
      "target": {
        "agent_id": "default",
        "category_id": "CAT-014",
        "chat_id": "session-smart-home",
        "group_id": "group-home-automation"
      },
      "type": "active",
      "version": "1.0.0"
    }
  ],
  "version": "1.0.0"
}