        "agent_id": "crypto-analyst",
        "category_id": "CAT-006",
        "chat_id": "session-crypto-trading",
        "group_id": "group-risk-council"
      },
      "type": "active",
      "version": "1.0.0"
    }
  ],
  "version": "1.0.0"
